//
// bitmap_replace — SpASM implementation.


// __bitmap_replace — dst = (old & mask) | (new & ~mask) word by word.

export fn spasm_bitmap_replace(dst: ptr<usize>, oldp: ptr<usize>?, newp: ptr<usize>?, maskp: ptr<usize>?, bits: usize) -> usize {
    var lim: usize = bits >> 6;
    var k: usize = 0;
    var old: usize = 0;
    var ne: usize = 0;
    var mask: usize = 0;
    var v: usize = 0;
    var loop: u8 = 1;
    while (loop == 1) {
        if (k == lim) {
            loop = 0;
        } else {
            old = ptr_load<usize>(oldp);
            ne = ptr_load<usize>(newp);
            mask = ptr_load<usize>(maskp);
            v = old & mask;
            mask = mask ^ 18446744073709551615;
            ne = ne & mask;
            v = v | ne;
            ptr_store<usize>(dst, v);
            dst = ptr_offset<usize>(dst, 8);
            oldp = ptr_offset<usize>(oldp, 8);
            newp = ptr_offset<usize>(newp, 8);
            maskp = ptr_offset<usize>(maskp, 8);
            k = k + 1;
        }
    }
    return 0;
}

