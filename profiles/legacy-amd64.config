# Perfil opt-in para construir controladores históricos fuera de standard.
# No se aplica al kernel instalado salvo solicitud expresa del usuario.

CONFIG_STAGING=y
CONFIG_COMEDI=m
CONFIG_ATM=m
CONFIG_ARCNET=m
CONFIG_FDDI=y
CONFIG_PCMCIA=m
CONFIG_MTD=m
CONFIG_MEDIA_ANALOG_TV_SUPPORT=y
CONFIG_MEDIA_RADIO_SUPPORT=y

