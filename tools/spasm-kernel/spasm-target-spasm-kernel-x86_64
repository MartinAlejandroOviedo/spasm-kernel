#!/usr/bin/env python3
"""Entrada estable del target nativo SpASM para SpASM Kernel x86_64."""

import argparse
from pathlib import Path
import subprocess
import sys


TARGET = "spasm-kernel-x86_64"
BACKEND = Path(__file__).with_name("spasm-kmod-native.py")


def parser():
    command = argparse.ArgumentParser(
        prog="spasm-target-spasm-kernel-x86_64",
        description="Compila un módulo SpASM nativo para SpASM Kernel x86_64.",
    )
    command.add_argument("source", type=Path, help="fuente .spasm")
    output = command.add_mutually_exclusive_group(required=True)
    output.add_argument("--out-dir", type=Path)
    output.add_argument("--out", type=Path)
    command.add_argument("--emit", choices=("asm",), default="asm")
    command.add_argument("--target", choices=(TARGET,), default=TARGET)
    command.add_argument("--verbose", action="store_true")
    return command


def fail(message):
    print(f"error: {message}", file=sys.stderr)
    return 2


def main(argv=None):
    args = parser().parse_args(argv)
    source = args.source.resolve()
    out_dir = args.out_dir.resolve() if args.out_dir else None
    out_file = args.out.resolve() if args.out else None

    if source.suffix != ".spasm":
        return fail(f"la fuente debe terminar en .spasm: {source}")
    if not source.is_file():
        return fail(f"no existe la fuente: {source}")
    if not BACKEND.is_file():
        return fail(f"no existe el backend nativo: {BACKEND}")

    command = [
        sys.executable,
        str(BACKEND),
        str(source),
    ]
    if out_dir:
        command.extend(["--out-dir", str(out_dir)])
    else:
        command.extend(
            ["--out-dir", str(out_file.parent), "--kind", "builtin"]
        )
    if args.verbose:
        print("+ " + " ".join(command), file=sys.stderr)
    result = subprocess.run(command, check=False)
    if result.returncode == 0 and out_file:
        generated = out_file.parent / f"{source.stem}_native.S"
        if not generated.is_file():
            return fail(f"el backend no genero la salida esperada: {generated}")
        generated.replace(out_file)
        makefile = out_file.parent / "Makefile"
        if makefile.exists():
            makefile.unlink()
    return result.returncode


if __name__ == "__main__":
    raise SystemExit(main())
