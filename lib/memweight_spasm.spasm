//
// memweight — count set bits in arbitrary memory (byte-by-byte using hweight8).

fn spasm_hweight8_local(w: u8) -> usize {
    var res: u8 = w;
    var t: u8 = res >> 1;
    t = t & 85;
    res = res - t;
    t = res >> 2;
    t = t & 51;
    res = res & 51;
    res = res + t;
    t = res >> 4;
    res = res + t;
    res = res & 15;
    return res;
}

export fn spasm_memweight(ptr: ptr<u8>?, bytes: usize) -> usize {
    var ret: usize = 0;
    var b: u8 = 0;
    var loop: u8 = 1;
    var w: usize = 0;
    while (loop == 1) {
        if (bytes == 0) {
            loop = 0;
        } else {
            b = ptr_load<u8>(ptr);
            w = spasm_hweight8_local(b);
            ret = ret + w;
            ptr = ptr_offset<u8>(ptr, 1);
            bytes = bytes - 1;
        }
    }
    return ret;
}
