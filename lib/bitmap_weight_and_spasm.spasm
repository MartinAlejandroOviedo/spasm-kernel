//
// __bitmap_weight_and — count set bits in (b1 & b2).

fn hw64(w: usize) -> usize {
    var t: usize = w >> 1;
    t = t & 6148914691236517205;
    var res: usize = w - t;
    t = res & 3689348814741910323;
    res = res >> 2;
    res = res & 3689348814741910323;
    res = res + t;
    t = res >> 4;
    res = res + t;
    res = res & 1085102592571150095;
    t = res >> 8;
    res = res + t;
    t = res >> 16;
    res = res + t;
    t = res >> 32;
    res = res + t;
    res = res & 127;
    return res;
}

export fn spasm_bitmap_weight_and(b1: ptr<usize>?, b2: ptr<usize>?, bits: usize) -> usize {
    var w: usize = 0;
    var lim: usize = bits >> 6;
    var k: usize = 0;
    var v1: usize = 0;
    var v2: usize = 0;
    var v: usize = 0;
    var loop: u8 = 1;
    while (loop == 1) {
        if (k == lim) {
            loop = 0;
        } else {
            v1 = ptr_load<usize>(b1);
            v2 = ptr_load<usize>(b2);
            v = v1 & v2;
            v = hw64(v);
            w = w + v;
            b1 = ptr_offset<usize>(b1, 8);
            b2 = ptr_offset<usize>(b2, 8);
            k = k + 1;
        }
    }
    return w;
}
