#!/bin/sh
# SPDX-License-Identifier: GPL-2.0-only
set -eu

script_dir=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
kernel_src=$(CDPATH= cd -- "$script_dir/../../../.." && pwd)
project_parent=$(CDPATH= cd -- "$kernel_src/.." && pwd)
kernel_build=${KERNEL_BUILD:-"$project_parent/build-spasm-kernel-dual"}
spasmc=${SPASMC:-/home/martin/Documentos/SpASM/tools/spasmc.py}
host_tools="$kernel_src/tools/spasm-kernel/host-tools"

die()
{
	echo "not ok - $*" >&2
	exit 1
}

[ -f "$kernel_build/.config" ] || die "falta configuracion dual"
grep -q '^CONFIG_SPASM_KERNEL_GCD_DUAL=y$' "$kernel_build/.config" ||
	die "el build no selecciona el modo dual"

PATH="$host_tools:$PATH" make -s -C "$kernel_src" O="$kernel_build" \
	ARCH=x86_64 SPASMC="$spasmc" -j"${JOBS:-8}" lib/math/

for object in gcd.o gcd_spasm.o gcd_dual.o; do
	[ -s "$kernel_build/lib/math/$object" ] ||
		die "falta el objeto dual $object"
done
echo "ok - dual_objects"

nm "$kernel_build/lib/math/gcd.o" |
	grep -Eq '[[:space:]]T[[:space:]]spasm_gcd_c$' ||
	die "la referencia C no fue aislada"
nm "$kernel_build/lib/math/gcd_spasm.o" |
	grep -Eq '[[:space:]]T[[:space:]]spasm_gcd$' ||
	die "la candidata SpASM no fue aislada"
nm "$kernel_build/lib/math/gcd_dual.o" |
	grep -Eq '[[:space:]]T[[:space:]]gcd$' ||
	die "el adaptador no preserva gcd"
echo "ok - dual_symbol_isolation"

objdump -dr --disassemble=gcd "$kernel_build/lib/math/gcd_dual.o" |
	grep -q 'spasm_gcd_c' || die "el adaptador no llama a C"
objdump -dr --disassemble=gcd "$kernel_build/lib/math/gcd_dual.o" |
	grep -q 'spasm_gcd' || die "el adaptador no llama a SpASM"
objdump -dr --disassemble=gcd "$kernel_build/lib/math/gcd_dual.o" |
	grep -q 'lock incq' || die "el adaptador no contabiliza ejecuciones"
echo "ok - dual_comparison_path"

if [ -f "$kernel_build/vmlinux" ]; then
	count=$(nm "$kernel_build/vmlinux" | awk '$3 == "gcd" { count++ } END { print count + 0 }')
	[ "$count" -eq 1 ] || die "vmlinux no contiene un unico gcd"
	nm "$kernel_build/vmlinux" | grep -q '__ksymtab_gcd$' ||
		die "vmlinux no exporta gcd"
	echo "ok - dual_vmlinux_contract"
	echo "1..4"
	echo "# spasm-kernel gcd dual: CONFORME"
else
	echo "1..3"
	echo "# spasm-kernel gcd dual: objetos conformes; vmlinux aun no construido"
fi
