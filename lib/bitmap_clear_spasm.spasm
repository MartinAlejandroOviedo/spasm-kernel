//
// bitmap_clear — SpASM implementation.


// __bitmap_clear — simplified: clears len bits starting at start.

export fn spasm_bitmap_clear(map: ptr<usize>, start: usize, len: usize) -> usize {
    var word_off: usize = start >> 6;
    var bit_off: usize = start & 63;
    var off: usize = word_off << 3;
    var p: ptr<usize> = ptr_offset<usize>(map, off);
    var mask: usize = 18446744073709551615;
    mask = mask << bit_off;
    mask = mask ^ 18446744073709551615;
    var val: usize = ptr_load<usize>(p);
    val = val & mask;
    ptr_store<usize>(p, val);
    return 0;
}

