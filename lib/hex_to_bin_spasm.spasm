//
// SpASM Kernel replacement for Linux hex_to_bin().

export fn spasm_hex_to_bin(ch: i32) -> i32 {
	var tmp: i32 = 0;
	if (ch >= 48) {
		if (ch <= 57) {
			tmp = ch - 48;
			return tmp;
		}
	}
	if (ch >= 65) {
		if (ch <= 70) {
			tmp = ch - 65;
			tmp = tmp + 10;
			return tmp;
		}
	}
	if (ch >= 97) {
		if (ch <= 102) {
			tmp = ch - 97;
			tmp = tmp + 10;
			return tmp;
		}
	}
	return -1;
}
