//
// __sw_hweight64 — Hamming weight for 64-bit values.

export fn spasm_hweight64(w: usize) -> usize {
    var t: usize = w >> 1;
    t = t & 6148914691236517205;
    var res: usize = w - t;
    t = res & 3689348814741910323;
    res = res >> 2;
    res = res & 3689348814741910323;
    res = res + t;
    t = res >> 4;
    res = res + t;
    res = res & 1085102592571150095;
    t = res >> 8;
    res = res + t;
    t = res >> 16;
    res = res + t;
    t = res >> 32;
    res = res + t;
    res = res & 127;
    return res;
}
