export fn spasm_crc64_be(crc: usize, p: ptr<u8>?, len: usize) -> usize {
    var loop: u8 = 1;
    var b: u8 = 0;
    var idx: usize = 0;
    var off: usize = 0;
    var tv: usize = 0;
    var t: usize = crc;
    while (loop == 1) {
        if (len == 0) {
            loop = 0;
        } else {
            b = ptr_load<u8>(p);
            idx = t >> 56;
            idx = idx ^ b;
            idx = idx & 255;
            off = idx << 3;
            tv = ptr_load<usize>(crc64_be_table, off);
            t = t << 8;
            t = t ^ tv;
            p = ptr_offset<u8>(p, 1);
            len = len - 1;
        }
    }
    return t;
}
