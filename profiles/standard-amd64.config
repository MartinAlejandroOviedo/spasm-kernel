# spasm-kernel — perfil estándar amd64 contemporáneo
#
# Se aplica sobre la configuración de escritorio validada. Mantiene como
# módulos los controladores habituales y elimina familias históricas que deben
# vivir en un perfil opt-in.

CONFIG_LOCALVERSION="-spasm-kernel-standard-amd64"

CONFIG_BLK_DEV_NVME=m
CONFIG_SATA_AHCI=m
CONFIG_ATA_PIIX=m
CONFIG_BLK_DEV_SD=m
CONFIG_USB_XHCI_PCI=m
CONFIG_USB_HID=m
CONFIG_HID_GENERIC=m
CONFIG_INPUT_EVDEV=m
CONFIG_EXT4_FS=m
CONFIG_VFAT_FS=m
CONFIG_SQUASHFS=m
CONFIG_BLK_DEV_DM=m
CONFIG_DM_CRYPT=m

CONFIG_DRM_AMDGPU=m
CONFIG_DRM_I915=m
CONFIG_DRM_NOUVEAU=m
CONFIG_R8169=m
CONFIG_E1000E=m
CONFIG_IGC=m
CONFIG_IWLWIFI=m
CONFIG_ATH9K=m
CONFIG_RTW88=m
CONFIG_RTW89=m
CONFIG_SND_HDA_INTEL=m
CONFIG_SND_USB_AUDIO=m
CONFIG_BT_HCIBTUSB=m
CONFIG_USB_VIDEO_CLASS=m
CONFIG_INPUT_UINPUT=m
CONFIG_MOUSE_PS2=m

# Fuera del estándar: hardware histórico, experimental o industrial.
CONFIG_MEDIA_SUPPORT_FILTER=y
# CONFIG_STAGING is not set
# CONFIG_COMEDI is not set
# CONFIG_ATM is not set
# CONFIG_ARCNET is not set
# CONFIG_FDDI is not set
# CONFIG_PCMCIA is not set
# CONFIG_MTD is not set
# CONFIG_HAMRADIO is not set
# CONFIG_ISDN is not set
# CONFIG_INFINIBAND is not set
# CONFIG_SCSI_LOWLEVEL is not set
# CONFIG_TARGET_CORE is not set
# CONFIG_DRM_ACCEL is not set
# CONFIG_IIO is not set
# CONFIG_NFC is not set
# CONFIG_IEEE802154 is not set
# CONFIG_6LOWPAN is not set
# CONFIG_CAN is not set
# CONFIG_WWAN is not set
# CONFIG_NET_DSA is not set
# CONFIG_VDPA is not set
# CONFIG_W1 is not set
# CONFIG_GREYBUS is not set
# CONFIG_MOST is not set
# CONFIG_USB_GADGET is not set
# CONFIG_USBIP_CORE is not set
# CONFIG_PARPORT is not set
# CONFIG_MEDIA_ANALOG_TV_SUPPORT is not set
# CONFIG_MEDIA_DIGITAL_TV_SUPPORT is not set
# CONFIG_MEDIA_RADIO_SUPPORT is not set
# CONFIG_MEDIA_SDR_SUPPORT is not set
# CONFIG_MEDIA_TEST_SUPPORT is not set
