choice
	prompt "Nice Kernel gcd implementation"
	default NICE_KERNEL_GCD_C
	depends on X86_64

config NICE_KERNEL_GCD_C
	bool "Original Linux C implementation"

config NICE_KERNEL_SPASM_GCD
	bool "SpASM implementation"
	help
	  Build the kernel's gcd() implementation from SpASM while preserving
	  the existing Linux x86_64 ABI and exported symbol.

	  This is the first reversible function migration for Nice Kernel.

config NICE_KERNEL_GCD_DUAL
	bool "Dual C/SpASM comparison"
	help
	  Execute the original C implementation and the SpASM implementation
	  for every gcd() call. Return the SpASM result and report any mismatch.
	  This mode is intended for migration validation, not production.

endchoice

choice
	prompt "Nice Kernel int_sqrt implementation"
	default NICE_KERNEL_INT_SQRT_C
	depends on X86_64

config NICE_KERNEL_INT_SQRT_C
	bool "Original Linux C implementation"

config NICE_KERNEL_INT_SQRT_SPASM
	bool "SpASM implementation"
	help
	  Build the kernel's int_sqrt() implementation from SpASM while
	  preserving the existing Linux x86_64 ABI and exported symbol.

config NICE_KERNEL_INT_SQRT_DUAL
	bool "Dual C/SpASM comparison"
	help
	  Execute the original C implementation and the SpASM implementation
	  for every int_sqrt() call. Return the SpASM result and report any
	  mismatch. This mode is intended for migration validation.

endchoice

config CORDIC
	tristate "CORDIC algorithm"
	help
	  This option provides an implementation of the CORDIC algorithm;
	  calculations are in fixed point. Module will be called cordic.

config PRIME_NUMBERS
	tristate "Simple prime number generator for testing"
	help
	  This option provides a simple prime number generator for test
	  modules.

	  If unsure, say N.

config RATIONAL
	tristate
