#!/usr/bin/env python3
"""Entrada estable del target nativo SpASM para Nice Kernel x86_64."""

import argparse
from pathlib import Path
import subprocess
import sys


TARGET = "nice-kernel-x86_64"
BACKEND = Path(__file__).with_name("spasm-kmod-native.py")


def parser():
    command = argparse.ArgumentParser(
        prog="spasm-target-nice-kernel-x86_64",
        description="Compila un módulo SpASM nativo para Nice Kernel x86_64.",
    )
    command.add_argument("source", type=Path, help="fuente .spasm")
    command.add_argument("--out-dir", type=Path, required=True)
    command.add_argument("--emit", choices=("asm",), default="asm")
    command.add_argument("--target", choices=(TARGET,), default=TARGET)
    command.add_argument("--verbose", action="store_true")
    return command


def fail(message):
    print(f"error: {message}", file=sys.stderr)
    return 2


def main(argv=None):
    args = parser().parse_args(argv)
    source = args.source.resolve()
    out_dir = args.out_dir.resolve()

    if source.suffix != ".spasm":
        return fail(f"la fuente debe terminar en .spasm: {source}")
    if not source.is_file():
        return fail(f"no existe la fuente: {source}")
    if not BACKEND.is_file():
        return fail(f"no existe el backend nativo: {BACKEND}")

    command = [
        sys.executable,
        str(BACKEND),
        str(source),
        "--out-dir",
        str(out_dir),
    ]
    if args.verbose:
        print("+ " + " ".join(command), file=sys.stderr)
    return subprocess.run(command, check=False).returncode


if __name__ == "__main__":
    raise SystemExit(main())
