#!/usr/bin/env python3
"""Minimal timeconst.bc runner for Nice Kernel build hosts without bc."""

import math
from pathlib import Path
import sys


def fmul(bits, numerator, denominator):
    return ((1 << bits) * numerator + denominator - 1) // denominator


def fadj(bits, numerator, denominator):
    denominator //= math.gcd(numerator, denominator)
    return (1 << bits) * (denominator - 1) // denominator


def fmuls(width, numerator, denominator):
    shift = 0
    while fmul(shift, numerator, denominator) < (1 << (width - 1)):
        shift += 1
    return shift


def pair(prefix, numerator, denominator):
    shift = fmuls(32, numerator, denominator)
    return [
        f"#define {prefix}_MUL32\tU64_C(0x{fmul(shift, numerator, denominator):X})",
        f"#define {prefix}_ADJ32\tU64_C(0x{fadj(shift, numerator, denominator):X})",
        f"#define {prefix}_SHR32\t{shift}",
    ]


def generate(hz):
    lines = [
        "/* Automatically generated by kernel/time/timeconst.bc */",
        f"/* Time conversion constants for HZ == {hz} */",
        "",
        "#ifndef KERNEL_TIMECONST_H",
        "#define KERNEL_TIMECONST_H",
        "",
        "#include <linux/param.h>",
        "#include <linux/types.h>",
        "",
        f"#if HZ != {hz}",
        '#error "include/generated/timeconst.h has the wrong HZ value!"',
        "#endif",
        "",
    ]
    if hz < 2:
        lines.append("#error Totally bogus HZ value!")
    else:
        lines.extend(pair("HZ_TO_MSEC", 1000, hz))
        lines.extend(pair("MSEC_TO_HZ", hz, 1000))
        divisor = math.gcd(hz, 1000)
        lines.extend(
            [
                f"#define HZ_TO_MSEC_NUM\t\t{1000 // divisor}",
                f"#define HZ_TO_MSEC_DEN\t\t{hz // divisor}",
                f"#define MSEC_TO_HZ_NUM\t\t{hz // divisor}",
                f"#define MSEC_TO_HZ_DEN\t\t{1000 // divisor}",
                "",
            ]
        )
        lines.extend(pair("HZ_TO_USEC", 1_000_000, hz))
        lines.extend(pair("USEC_TO_HZ", hz, 1_000_000))
        divisor = math.gcd(hz, 1_000_000)
        lines.extend(
            [
                f"#define HZ_TO_USEC_NUM\t\t{1_000_000 // divisor}",
                f"#define HZ_TO_USEC_DEN\t\t{hz // divisor}",
                f"#define USEC_TO_HZ_NUM\t\t{hz // divisor}",
                f"#define USEC_TO_HZ_DEN\t\t{1_000_000 // divisor}",
            ]
        )
        divisor = math.gcd(hz, 1_000_000_000)
        lines.extend(
            [
                f"#define HZ_TO_NSEC_NUM\t\t{1_000_000_000 // divisor}",
                f"#define HZ_TO_NSEC_DEN\t\t{hz // divisor}",
                f"#define NSEC_TO_HZ_NUM\t\t{hz // divisor}",
                f"#define NSEC_TO_HZ_DEN\t\t{1_000_000_000 // divisor}",
                "",
            ]
        )
    lines.extend(["#endif /* KERNEL_TIMECONST_H */", ""])
    return "\n".join(lines)


def main():
    scripts = [arg for arg in sys.argv[1:] if not arg.startswith("-")]
    if len(scripts) != 1 or Path(scripts[0]).name != "timeconst.bc":
        print("spasm-kernel bc: solamente se admite kernel/time/timeconst.bc", file=sys.stderr)
        return 2
    try:
        hz = int(sys.stdin.read().strip())
    except ValueError:
        print("spasm-kernel bc: HZ invalido", file=sys.stderr)
        return 2
    sys.stdout.write(generate(hz))
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
