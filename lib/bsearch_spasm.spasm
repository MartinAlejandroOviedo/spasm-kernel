//
// bsearch — binary search with callback.

export fn spasm_bsearch(key: ptr<u8>, base: ptr<u8>?, num: usize, size: usize, cmp: fn(ptr<u8>, ptr<u8>) -> isize) -> ptr<u8>? {
    var pivot: ptr<u8> = base;
    var result: isize = 0;
    var half: usize = 0;
    var offset: usize = 0;
    var rem: usize = 0;
    var loop: u8 = 1;
    while (loop == 1) {
        if (num == 0) {
            loop = 0;
        } else {
            half = num >> 1;
            offset = half * size;
            pivot = ptr_offset<u8>(base, offset);
            result = cmp(key, pivot);
            if (result == 0) {
                return pivot;
            }
            if (result < 0) {
                num = half;
            } else {
                rem = half + 1;
                offset = rem * size;
                base = ptr_offset<u8>(base, offset);
                num = num - rem;
            }
        }
    }
    return 0;
}
