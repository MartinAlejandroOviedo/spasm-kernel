index 32e209bc7..0599959de 100644
--- a/scripts/Makefile.build
+++ b/scripts/Makefile.build
@@ -431,6 +431,20 @@ endif
 $(obj)/%.o: $(obj)/%.S FORCE
 	$(call if_changed_rule,as_o_S)
 
+# SpASM is a first-class Kbuild source. The generated assembly is retained so
+# diagnostics and binary audits can be traced back to the compiler output.
+spasm-tool-deps := \
+	$(wildcard $(SPASMC)) \
+	$(wildcard $(SPASM_TARGET_PATH)/spasm-kmod-native.py) \
+	$(SPASM_TARGET_PATH)/spasm-target-$(SPASM_TARGET)
+
+$(obj)/%.o: $(src)/%.spasm $(spasm-tool-deps) FORCE
+	$(call if_changed_rule,spasm_o)
+
+spasm-objs := $(foreach o,$(real-obj-y) $(real-obj-m) $(lib-y), \
+	$(if $(wildcard $(patsubst $(obj)/%.o,$(src)/%.spasm,$(o))),$(o)))
+targets += $(patsubst %.o,%.spasm.S,$(spasm-objs))
+
 targets += $(filter-out $(subdir-builtin), $(real-obj-y))
 targets += $(filter-out $(subdir-modorder), $(real-obj-m))
 targets += $(lib-y) $(always-y)
diff --git a/scripts/Makefile.lib b/scripts/Makefile.lib
index 28a1c08e3..fb453c5f2 100644
--- a/scripts/Makefile.lib
+++ b/scripts/Makefile.lib
@@ -264,6 +264,31 @@ define rule_as_o_S
 	$(call cmd,warn_shared_object)
 endef
 
+# Compile SpASM sources (.spasm)
+# ---------------------------------------------------------------------------
+#
+# SPASMC is deliberately supplied by the caller. This keeps Kbuild independent
+# of a developer's filesystem while allowing an explicit path to the compiler
+# script.
+SPASMC		   ?= spasmc
+SPASM_TARGET	   ?= spasm-kernel-x86_64
+SPASM_TARGET_PATH ?= $(srctree)/tools/spasm-kernel
+
+spasm_asm = $(@:.o=.spasm.S)
+
+quiet_cmd_spasm_o = SPASM $(quiet_modtag) $@
+      cmd_spasm_o = SPASMC_TARGET_PATH=$(SPASM_TARGET_PATH) \
+		    $(PYTHON3) $(SPASMC) $< --target $(SPASM_TARGET) \
+		    --out $(spasm_asm) && \
+		    $(CC) $(a_flags) -c -o $@ $(spasm_asm) $(cmd_objtool)
+
+define rule_spasm_o
+	$(call cmd_and_fixdep,spasm_o)
+	$(call cmd,gen_objtooldep)
+	$(call cmd,gen_symversions_S)
+	$(call cmd,warn_shared_object)
+endef
