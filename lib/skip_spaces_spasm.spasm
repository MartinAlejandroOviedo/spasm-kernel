//
// skip_spaces — advance pointer past ASCII whitespace.

fn spasm_is_space(c: u8) -> u8 {
    if (c == 32) {
        return 1;
    }
    if (c == 9) {
        return 1;
    }
    if (c == 10) {
        return 1;
    }
    if (c == 13) {
        return 1;
    }
    return 0;
}

export fn spasm_skip_spaces(s: ptr<u8>) -> ptr<u8> {
    var loop: u8 = 1;
    var c: u8 = 0;
    var sp: u8 = 0;
    while (loop == 1) {
        c = ptr_load<u8>(s);
        sp = spasm_is_space(c);
        if (sp == 1) {
            s = ptr_offset<u8>(s, 1);
        } else {
            loop = 0;
        }
    }
    return s;
}
