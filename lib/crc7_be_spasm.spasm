// crc7_be — CRC lookup-table computation.

static crc7_be_syndrome_table: usize[256] = {
0, 18, 36, 54, 72, 90, 108, 126,
144, 130, 180, 166, 216, 202, 252, 238,
50, 32, 22, 4, 122, 104, 94, 76,
162, 176, 134, 148, 234, 248, 206, 220,
100, 118, 64, 82, 44, 62, 8, 26,
244, 230, 208, 194, 188, 174, 152, 138,
86, 68, 114, 96, 30, 12, 58, 40,
198, 212, 226, 240, 142, 156, 170, 184,
200, 218, 236, 254, 128, 146, 164, 182,
88, 74, 124, 110, 16, 2, 52, 38,
250, 232, 222, 204, 178, 160, 150, 132,
106, 120, 78, 92, 34, 48, 6, 20,
172, 190, 136, 154, 228, 246, 192, 210,
60, 46, 24, 10, 116, 102, 80, 66,
158, 140, 186, 168, 214, 196, 242, 224,
14, 28, 42, 56, 70, 84, 98, 112,
130, 144, 166, 180, 202, 216, 238, 252,
18, 0, 54, 36, 90, 72, 126, 108,
176, 162, 148, 134, 248, 234, 220, 206,
32, 50, 4, 22, 104, 122, 76, 94,
230, 244, 194, 208, 174, 188, 138, 152,
118, 100, 82, 64, 62, 44, 26, 8,
212, 198, 240, 226, 156, 142, 184, 170,
68, 86, 96, 114, 12, 30, 40, 58,
74, 88, 110, 124, 2, 16, 38, 52,
218, 200, 254, 236, 146, 128, 182, 164,
120, 106, 92, 78, 48, 34, 20, 6,
232, 250, 204, 222, 160, 178, 132, 150,
46, 60, 10, 24, 102, 116, 66, 80,
190, 172, 154, 136, 246, 228, 210, 192,
28, 14, 56, 42, 84, 70, 112, 98,
140, 158, 168, 186, 196, 214, 224, 242
};

export fn spasm_crc7_be(crc: usize, p: ptr<u8>?, len: usize) -> usize {
    var loop: u8 = 1;
    var b: u8 = 0;
    var idx: usize = 0;
    var off: usize = 0;
    var tv: usize = 0;
    var t: usize = crc;
    while (loop == 1) {
        if (len == 0) {
            loop = 0;
        } else {
            b = ptr_load<u8>(p);
            idx = t ^ b;
            idx = idx & 255;
            off = idx << 3;
            tv = ptr_load<usize>(crc7_be_syndrome_table, off);
            t = tv;
            t = t & 65535;
            p = ptr_offset<u8>(p, 1);
            len = len - 1;
        }
    }
    return t;
}
