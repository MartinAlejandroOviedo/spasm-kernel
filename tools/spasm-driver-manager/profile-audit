#!/usr/bin/env python3
"""Audit a kernel .config against a spasm-kernel profile fragment."""

from __future__ import annotations

import argparse
import json
from pathlib import Path
import re


SET_RE = re.compile(r"^(CONFIG_[A-Z0-9_]+)=(y|m|.+)$")
UNSET_RE = re.compile(r"^# (CONFIG_[A-Z0-9_]+) is not set$")


def read_config(path: Path) -> dict[str, str]:
    values: dict[str, str] = {}
    for raw in path.read_text(encoding="utf-8").splitlines():
        line = raw.strip()
        match = SET_RE.match(line)
        if match:
            values[match.group(1)] = match.group(2)
            continue
        match = UNSET_RE.match(line)
        if match:
            values[match.group(1)] = "n"
    return values


def main() -> int:
    parser = argparse.ArgumentParser()
    parser.add_argument("--config", type=Path, required=True)
    parser.add_argument("--profile", type=Path, required=True)
    parser.add_argument("--baseline", type=Path)
    parser.add_argument("--json", action="store_true")
    args = parser.parse_args()

    config = read_config(args.config)
    expected = read_config(args.profile)
    violations = [
        {"symbol": symbol, "expected": value, "actual": config.get(symbol, "missing")}
        for symbol, value in sorted(expected.items())
        if config.get(symbol) != value
    ]
    counts = {
        value: sum(current == value for current in config.values())
        for value in ("y", "m", "n")
    }
    result = {
        "schema": "spasm-kernel-profile-audit-v1",
        "config": str(args.config),
        "profile": str(args.profile),
        "counts": counts,
        "requirements": len(expected),
        "violations": violations,
        "status": "ok" if not violations else "error",
    }
    if args.baseline:
        baseline = read_config(args.baseline)
        baseline_counts = {
            value: sum(current == value for current in baseline.values())
            for value in ("y", "m", "n")
        }
        result["baseline"] = str(args.baseline)
        result["baseline_counts"] = baseline_counts
        result["module_delta"] = counts["m"] - baseline_counts["m"]
        result["module_reduction_percent"] = round(
            (baseline_counts["m"] - counts["m"]) * 100 / baseline_counts["m"],
            1,
        )
    if args.json:
        print(json.dumps(result, indent=2, sort_keys=True))
    else:
        print(
            f"profile={result['status']} requirements={len(expected)} "
            f"violations={len(violations)} y={counts['y']} m={counts['m']}"
        )
        if args.baseline:
            print(
                f"baseline_m={result['baseline_counts']['m']} "
                f"delta_m={result['module_delta']} "
                f"reduction={result['module_reduction_percent']}%"
            )
        for violation in violations:
            print(
                f"- {violation['symbol']}: esperado={violation['expected']} "
                f"actual={violation['actual']}"
            )
    return 0 if not violations else 1


if __name__ == "__main__":
    raise SystemExit(main())
