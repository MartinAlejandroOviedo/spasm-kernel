//
// __bitmap_intersects — check if two bitmaps share any set bit.

export fn spasm_bitmap_intersects(b1: ptr<usize>?, b2: ptr<usize>?, bits: usize) -> usize {
    var lim: usize = bits >> 6;
    var k: usize = 0;
    var v1: usize = 0;
    var v2: usize = 0;
    var v: usize = 0;
    var loop: u8 = 1;
    while (loop == 1) {
        if (k == lim) {
            loop = 0;
        } else {
            v1 = ptr_load<usize>(b1);
            v2 = ptr_load<usize>(b2);
            v = v1 & v2;
            if (v != 0) {
                return 1;
            }
            b1 = ptr_offset<usize>(b1, 8);
            b2 = ptr_offset<usize>(b2, 8);
            k = k + 1;
        }
    }
    return 0;
}
