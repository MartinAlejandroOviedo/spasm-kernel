//
// Machine Care policy core v1.
// Pure and deterministic: the caller supplies normalized system signals and
// receives GREEN(0), YELLOW(1), ORANGE(2), RED(3), or EMERGENCY(4).

export fn spasm_care_level_v1(cpu_pct: usize, cpu_temp_c: usize, ram_free_mb: usize) -> usize {
	if (cpu_temp_c >= 95) {
		return 4;
	}
	if (ram_free_mb < 64) {
		return 4;
	}
	if (cpu_temp_c >= 85) {
		return 3;
	}
	if (ram_free_mb < 128) {
		return 3;
	}
	if (cpu_pct >= 85) {
		if (cpu_temp_c >= 75) {
			return 3;
		}
	}
	if (cpu_temp_c >= 75) {
		return 2;
	}
	if (ram_free_mb < 256) {
		return 2;
	}
	if (cpu_pct >= 85) {
		return 1;
	}
	return 0;
}
