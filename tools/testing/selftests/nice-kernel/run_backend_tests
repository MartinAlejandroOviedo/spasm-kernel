#!/bin/bash
set -euo pipefail

script_dir=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
kernel_src=$(CDPATH= cd -- "$script_dir/../../../.." && pwd)
target="$kernel_src/tools/spasm-kernel/spasm-target-nice-kernel-x86_64"
sample="$kernel_src/samples/spasm/hello_kmod.spasm"
test_root=$(mktemp -d)
trap 'rm -rf -- "$test_root"' EXIT

pass=0
fail=0

expect_success()
{
	local name=$1
	shift
	if "$@" >"$test_root/$name.out" 2>"$test_root/$name.err"; then
		echo "ok - $name"
		pass=$((pass + 1))
	else
		echo "not ok - $name"
		fail=$((fail + 1))
	fi
}

expect_failure()
{
	local name=$1
	shift
	if "$@" >"$test_root/$name.out" 2>"$test_root/$name.err"; then
		echo "not ok - $name"
		fail=$((fail + 1))
	else
		echo "ok - $name"
		pass=$((pass + 1))
	fi
}

expect_success valid_module \
	"$target" "$sample" --out-dir "$test_root/valid"
test -s "$test_root/valid/spasm_hello_native.S"
test -s "$test_root/valid/Makefile"
if find "$test_root/valid" -type f -name '*.c' | grep -q .; then
	echo "not ok - native_output_contains_no_c"
	fail=$((fail + 1))
else
	echo "ok - native_output_contains_no_c"
	pass=$((pass + 1))
fi

expect_failure missing_source \
	"$target" "$test_root/missing.spasm" --out-dir "$test_root/missing"
expect_failure invalid_extension \
	"$target" "$sample.txt" --out-dir "$test_root/extension"

printf 'module "broken"\\nlicense "GPL"\\non load {\\n  desconocido\\n}\\n' \
	>"$test_root/invalid.spasm"
expect_failure invalid_statement \
	"$target" "$test_root/invalid.spasm" --out-dir "$test_root/invalid"

printf '%s\n' \
	'module "range"' \
	'license "GPL"' \
	'on load { var valor: u8 = 256; return 0 }' \
	'on unload { return 0 }' \
	>"$test_root/range.spasm"
expect_failure integer_out_of_range \
	"$target" "$test_root/range.spasm" --out-dir "$test_root/range"

printf '%s\n' \
	'module "unknown_type"' \
	'license "GPL"' \
	'on load { var valor: word = 1; return 0 }' \
	'on unload { return 0 }' \
	>"$test_root/unknown_type.spasm"
expect_failure unknown_integer_type \
	"$target" "$test_root/unknown_type.spasm" \
	--out-dir "$test_root/unknown_type"

printf '%s\n' \
	'module "wrong_args"' \
	'license "GPL"' \
	'fn sumar(a: i64, b: i64) -> i64 { return a + b; }' \
	'on load { var valor: i64 = sumar(1); return 0 }' \
	'on unload { return 0 }' \
	>"$test_root/wrong_args.spasm"
expect_failure wrong_argument_count \
	"$target" "$test_root/wrong_args.spasm" \
	--out-dir "$test_root/wrong_args"

printf '%s\n' \
	'module "wrong_type"' \
	'license "GPL"' \
	'fn identidad(a: u16) -> u16 { return a; }' \
	'on load {' \
	'  var pequeno: u8 = 1;' \
	'  var valor: u16 = identidad(pequeno);' \
	'  return 0' \
	'}' \
	'on unload { return 0 }' \
	>"$test_root/wrong_type.spasm"
expect_failure incompatible_argument_type \
	"$target" "$test_root/wrong_type.spasm" \
	--out-dir "$test_root/wrong_type"

echo "1..$((pass + fail))"
echo "# pass=$pass fail=$fail"
test "$fail" -eq 0
