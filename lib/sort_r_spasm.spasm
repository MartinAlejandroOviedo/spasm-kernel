//
// sort_r — insertion sort with private data parameter.
// Same as sort but passes priv to cmp callback.

export fn spasm_sort_r(base: ptr<u8>, num: usize, size: usize, cmp: fn(ptr<u8>, ptr<u8>, ptr<u8>) -> isize, swap: fn(ptr<u8>, ptr<u8>, usize), priv: ptr<u8>) -> usize {
    var i: usize = 1;
    var j: usize = 0;
    var loop_i: u8 = 1;
    var a_off: usize = 0;
    var b_off: usize = 0;
    var a: ptr<u8> = base;
    var b: ptr<u8> = base;
    var r: isize = 0;
    var d: usize = 0;
    while (loop_i == 1) {
        if (i == num) {
            loop_i = 0;
        } else {
            j = i;
            while (j > 0) {
                a_off = j * size;
                a = ptr_offset<u8>(base, a_off);
                b_off = j - 1;
                b_off = b_off * size;
                b = ptr_offset<u8>(base, b_off);
                r = cmp(a, b, priv);
                if (r < 0) {
                    d = swap(a, b, size);
                } else {
                }
                j = j - 1;
            }
            i = i + 1;
        }
    }
    return 0;
}
