# spasm-kernel — perfil desktop amd64
# Incluye mas hardware que el perfil standard, conserva compatibilidad amplia.

CONFIG_LOCALVERSION="-spasm-kernel-desktop-amd64"

CONFIG_BLK_DEV_NVME=m
CONFIG_SATA_AHCI=m
CONFIG_ATA_PIIX=m
CONFIG_BLK_DEV_SD=m
CONFIG_USB_XHCI_PCI=m
CONFIG_USB_HID=m
CONFIG_HID_GENERIC=m
CONFIG_INPUT_EVDEV=m
CONFIG_EXT4_FS=m
CONFIG_VFAT_FS=m
CONFIG_SQUASHFS=m
CONFIG_BLK_DEV_DM=m
CONFIG_DM_CRYPT=m

CONFIG_DRM_AMDGPU=m
CONFIG_DRM_I915=m
CONFIG_DRM_NOUVEAU=m
CONFIG_R8169=m
CONFIG_E1000E=m
CONFIG_IGC=m
CONFIG_IWLWIFI=m
CONFIG_ATH9K=m
CONFIG_RTW88=m
CONFIG_RTW89=m
CONFIG_SND_HDA_INTEL=m
CONFIG_SND_USB_AUDIO=m
CONFIG_BT_HCIBTUSB=m
CONFIG_USB_VIDEO_CLASS=m
CONFIG_INPUT_UINPUT=m
CONFIG_MOUSE_PS2=m

# Desktop: permite subsistemas del build completo
CONFIG_STAGING=y
CONFIG_DRM_ACCEL=y
CONFIG_FDDI=y
CONFIG_MEDIA_ANALOG_TV_SUPPORT=y
CONFIG_MEDIA_DIGITAL_TV_SUPPORT=y
CONFIG_MEDIA_RADIO_SUPPORT=y
CONFIG_MEDIA_SDR_SUPPORT=y
CONFIG_MEDIA_TEST_SUPPORT=y
CONFIG_MTD=m
CONFIG_PARPORT=m
CONFIG_PCMCIA=m
CONFIG_TARGET_CORE=m
CONFIG_USBIP_CORE=m
CONFIG_USB_GADGET=m
CONFIG_VDPA=m
CONFIG_W1=m
CONFIG_WWAN=m
CONFIG_6LOWPAN=m
CONFIG_ARCNET=m
CONFIG_ATM=m
CONFIG_CAN=m
CONFIG_COMEDI=m
CONFIG_IEEE802154=m
CONFIG_IIO=m
CONFIG_MEDIA_SUPPORT_FILTER=n
